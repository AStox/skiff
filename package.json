{
  "name": "skiff",
  "productName": "Skiff",
  "version": "0.1.0",
  "description": "Bare-bones Arc-like browser whose interface is a replaceable shell folder driven by one command API",
  "main": "src/main.js",
  "private": true,
  "bin": {
    "skiff": "bin/skiff"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots=all",
    "app": "electron-packager . Skiff --platform=darwin --out=dist --overwrite --ignore=^/test --ignore=^/e2e --ignore=^/playwright --ignore=^/dist"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.65.0",
    "electron": "^45.3.0"
  }
}
